{
  "name": "switchy",
  "version": "0.1.0",
  "description": "One monitor. Two computers. One switch.",
  "author": "givhvy",
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg zip --arm64 --publish never",
    "pack": "electron-builder --dir --publish never"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.givhvy.switchy",
    "productName": "Switchy",
    "artifactName": "Switchy-${version}-${os}-${arch}.${ext}",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native",
        "to": "native",
        "filter": [
          "**/*",
          "!**/*.c"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "identity": "-"
    },
    "directories": {
      "output": "dist"
    }
  }
}
